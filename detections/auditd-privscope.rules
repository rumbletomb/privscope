## PrivScope auditd starter policy
##
## Review and tune before deployment. These rules can be noisy, especially on
## multi-user systems, CI runners, container hosts and configuration-managed
## servers. Remove any -w rule whose path does not exist on the target, because
## auditctl/augenrules may reject it. These rules do not install themselves.

## Identity and elevation policy
-w /etc/passwd -p wa -k privscope_identity
-w /etc/shadow -p wa -k privscope_identity
-w /etc/group -p wa -k privscope_identity
-w /etc/gshadow -p wa -k privscope_identity
-w /etc/sudoers -p wa -k privscope_sudo_policy
-w /etc/sudoers.d -p wa -k privscope_sudo_policy
-w /etc/pam.d -p wa -k privscope_auth_policy
-w /etc/polkit-1/rules.d -p wa -k privscope_auth_policy

## Privileged scheduled execution and services
-w /etc/crontab -p wa -k privscope_scheduled_task
-w /etc/cron.d -p wa -k privscope_scheduled_task
-w /etc/cron.hourly -p wa -k privscope_scheduled_task
-w /etc/cron.daily -p wa -k privscope_scheduled_task
-w /etc/cron.weekly -p wa -k privscope_scheduled_task
-w /etc/cron.monthly -p wa -k privscope_scheduled_task
-w /etc/systemd/system -p wa -k privscope_systemd
-w /usr/lib/systemd/system -p wa -k privscope_systemd
-w /lib/systemd/system -p wa -k privscope_systemd

## Dynamic-linker configuration
-w /etc/ld.so.preload -p wa -k privscope_linker
-w /etc/ld.so.conf -p wa -k privscope_linker
-w /etc/ld.so.conf.d -p wa -k privscope_linker

## Root process execution attributed to a human login identity.
## Adjust auid floor if local interactive UIDs start below 1000.
-a always,exit -F arch=b64 -S execve,execveat -F euid=0 -F auid>=1000 -F auid!=unset -k privscope_root_exec
-a always,exit -F arch=b32 -S execve,execveat -F euid=0 -F auid>=1000 -F auid!=unset -k privscope_root_exec

## Identity-changing syscalls by human login identities. Expect legitimate sudo,
## su, login, container and service activity; correlate rather than alert alone.
-a always,exit -F arch=b64 -S setuid,setreuid,setresuid,setgid,setregid,setresgid -F auid>=1000 -F auid!=unset -k privscope_id_change
-a always,exit -F arch=b32 -S setuid,setreuid,setresuid,setgid,setregid,setresgid -F auid>=1000 -F auid!=unset -k privscope_id_change

## Capability and ownership/permission changes. These are intentionally broad.
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k privscope_xattr
-a always,exit -F arch=b32 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k privscope_xattr
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat,chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k privscope_metadata
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat,chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k privscope_metadata

## Kernel attack-surface changes
-w /etc/sysctl.conf -p wa -k privscope_kernel_policy
-w /etc/sysctl.d -p wa -k privscope_kernel_policy
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k privscope_kernel_module
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k privscope_kernel_module
